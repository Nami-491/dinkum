<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Mod Condition="'$(Mod)' == ''">FancyFeast</Mod>
    <AssemblyName Condition="'$(Mod)' != 'InventoryManagement'">Snaitf.Dinkum.$(Mod)</AssemblyName>
    <AssemblyName Condition="'$(Mod)' == 'InventoryManagement'">InventoryManagement</AssemblyName>
    <AssemblyName Condition="'$(Mod)' == 'EquipmentEnhancement'">LocalDinkum.EquipmentEnhancement</AssemblyName>
    <Version>1.0.0</Version>
    <GamePath Condition="'$(GamePath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Dinkum</GamePath>
    <ManagedPath>$(GamePath)/Dinkum_Data/Managed</ManagedPath>
    <LoaderPath Condition="'$(LoaderPath)' == ''">$(GamePath)/BepInEx/core</LoaderPath>
    <DefineConstants Condition="'$(Legacy)' == 'true'">$(DefineConstants);LEGACY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Mod).cs" /><Compile Include="Common.cs" />
    <Compile Include="DisplayRules.cs" />
    <Compile Include="../EquipmentEnhancement/EnhancementRules.cs" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="EnhancementRuntime.cs" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="EnhancementConversion.cs" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="EnhancementCompatibility.cs" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="EnhancementSaveUpgrade.cs" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <EmbeddedResource Include="native-catalog-25568182.tsv" LogicalName="native-catalog.tsv" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="DepositRules.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Compile Include="ItemLocks.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Compile Include="ItemLockRules.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Compile Include="LockedAutoStack.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Reference Include="$(ManagedPath)/Assembly-CSharp-firstpass.dll" Private="false" Condition="'$(Mod)' == 'InventoryManagement' Or '$(Mod)' == 'EquipmentEnhancement'" />
    <Compile Include="TransferProtocol.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Compile Include="DepositService.cs" Condition="'$(Mod)' == 'InventoryManagement'" />
    <Reference Include="$(ManagedPath)/FizzySteamworks.dll" Private="false" />
    <Reference Include="$(ManagedPath)/com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(LoaderPath)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(LoaderPath)/BepInEx.Unity.Mono.dll" Private="false" Condition="'$(Legacy)' != 'true'" />
    <Reference Include="$(LoaderPath)/BepInEx.Unity.dll" Private="false" Condition="'$(Legacy)' == 'true'" />
    <Reference Include="$(LoaderPath)/0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedPath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedPath)/Mirror.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine.UIModule.dll" Private="false" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Reference Include="$(ManagedPath)/UnityEngine.TextRenderingModule.dll" Private="false" Condition="'$(Mod)' == 'EquipmentEnhancement'" />
    <Reference Include="$(ManagedPath)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedPath)/Unity.TextMeshPro.dll" Private="false" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
